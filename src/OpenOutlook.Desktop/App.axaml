<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OpenOutlook.Desktop.App" RequestedThemeVariant="Light">
  <!--
    Palette for the Outlook 2024 classic look. The light values come from measuring the owner's
    screenshots of classic Outlook — chrome #F0F0F0 with white content cards on top of it, #F4F4F4 date
    bands, grey row selection, and blue reserved for accents such as the active tab underline and unread
    counts — so the appearance follows the reference rather than an impression of it. Dark variants keep
    the same structure; every surface reads these keys through DynamicResource, so toggling
    RequestedThemeVariant restyles the whole window.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="OlChrome" Color="#F0F0F0" />
          <SolidColorBrush x:Key="OlCard" Color="#FFFFFF" />
          <SolidColorBrush x:Key="OlCardBorder" Color="#E1E1E1" />
          <SolidColorBrush x:Key="OlHairline" Color="#ECECEC" />
          <SolidColorBrush x:Key="OlStrongBorder" Color="#D2D2D2" />
          <SolidColorBrush x:Key="OlText" Color="#1F1F1F" />
          <SolidColorBrush x:Key="OlTextSecondary" Color="#616161" />
          <SolidColorBrush x:Key="OlTextTertiary" Color="#8A8A8A" />
          <SolidColorBrush x:Key="OlAccent" Color="#0F6CBD" />
          <SolidColorBrush x:Key="OlHover" Color="#F4F4F4" />
          <SolidColorBrush x:Key="OlPressed" Color="#E5E5E5" />
          <SolidColorBrush x:Key="OlSelected" Color="#E8E8E8" />
          <SolidColorBrush x:Key="OlGroupBand" Color="#F4F4F4" />
          <SolidColorBrush x:Key="OlField" Color="#F7F7F7" />
          <SolidColorBrush x:Key="OlIcon" Color="#3B3B3B" />
          <!-- Backstage (File menu): nav column #E4E4E4 measured from the reference, pane #F5F5F5 -->
          <SolidColorBrush x:Key="OlBackstageNav" Color="#E4E4E4" />
          <SolidColorBrush x:Key="OlBackstagePane" Color="#F5F5F5" />
          <SolidColorBrush x:Key="OlBsDisabled" Color="#C9C9C9" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="OlChrome" Color="#1F1F1F" />
          <SolidColorBrush x:Key="OlCard" Color="#2A2A2A" />
          <SolidColorBrush x:Key="OlCardBorder" Color="#3A3A3A" />
          <SolidColorBrush x:Key="OlHairline" Color="#333333" />
          <SolidColorBrush x:Key="OlStrongBorder" Color="#4A4A4A" />
          <SolidColorBrush x:Key="OlText" Color="#F2F2F2" />
          <SolidColorBrush x:Key="OlTextSecondary" Color="#B5B5B5" />
          <SolidColorBrush x:Key="OlTextTertiary" Color="#969696" />
          <SolidColorBrush x:Key="OlAccent" Color="#4FA3E3" />
          <SolidColorBrush x:Key="OlHover" Color="#333333" />
          <SolidColorBrush x:Key="OlPressed" Color="#3E3E3E" />
          <SolidColorBrush x:Key="OlSelected" Color="#3A3A3A" />
          <SolidColorBrush x:Key="OlGroupBand" Color="#262626" />
          <SolidColorBrush x:Key="OlField" Color="#333333" />
          <SolidColorBrush x:Key="OlIcon" Color="#D6D6D6" />
          <SolidColorBrush x:Key="OlBackstageNav" Color="#2B2B2B" />
          <SolidColorBrush x:Key="OlBackstagePane" Color="#1E1E1E" />
          <SolidColorBrush x:Key="OlBsDisabled" Color="#5A5A5A" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://OpenOutlook.Desktop/Assets/OutlookIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
    <!-- Classic Outlook accent: checked boxes, focus borders and selection follow it. -->
    <Color x:Key="SystemAccentColor">#0F6CBD</Color>
    <Color x:Key="SystemAccentColorLight1">#4A9AD8</Color>
    <Color x:Key="SystemAccentColorLight2">#7DB8E4</Color>
    <Color x:Key="SystemAccentColorLight3">#B0D6F0</Color>
    <Color x:Key="SystemAccentColorDark1">#0D5AA8</Color>
    <Color x:Key="SystemAccentColorDark2">#0A4785</Color>
    <Color x:Key="SystemAccentColorDark3">#073562</Color>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://OpenOutlook.Desktop/Assets/OutlookStyles.axaml" />
  </Application.Styles>
</Application>
