<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\openoutlook.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\openoutlook.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="11.4.1" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="PuppeteerSharp" Version="25.12.0" />
    <ProjectReference Include="../PstCore/PstCore.csproj" />
    <ProjectReference Include="../OpenOutlook.PstNative/OpenOutlook.PstNative.csproj" />
    <ProjectReference Include="../OpenOutlook.JunkCleaner/OpenOutlook.JunkCleaner.csproj" />
    <ProjectReference Include="../OpenOutlook.Auth/OpenOutlook.Auth.csproj" />
    <ProjectReference Include="../OpenOutlook.Mirror/OpenOutlook.Mirror.csproj" />
    <ProjectReference Include="../OpenOutlook.Providers.Microsoft/OpenOutlook.Providers.Microsoft.csproj" />
    <ProjectReference Include="../OpenOutlook.Providers.Google/OpenOutlook.Providers.Google.csproj" />
  </ItemGroup>
  <ItemGroup Condition="Exists('openoutlook-oauth.json')">
    <None Include="openoutlook-oauth.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The pinned headless Chromium that lays out HTML mail (scripts/fetch_chromium.py downloads it to third_party/chromium/<platform>); it is copied to a chromium folder next to the application. -->
  <PropertyGroup>
    <ChromiumPlatform Condition="'$(RuntimeIdentifier)' == 'win-x64'">win64</ChromiumPlatform>
    <ChromiumPlatform Condition="'$(RuntimeIdentifier)' == 'linux-x64'">linux64</ChromiumPlatform>
    <ChromiumPlatform Condition="'$(ChromiumPlatform)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win64</ChromiumPlatform>
    <ChromiumPlatform Condition="'$(ChromiumPlatform)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">linux64</ChromiumPlatform>
    <ChromiumDir>$(MSBuildThisFileDirectory)../../third_party/chromium/$(ChromiumPlatform)/</ChromiumDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(ChromiumPlatform)' != '' And Exists('$(ChromiumDir)VERSION.txt')">
    <None Include="$(ChromiumDir)**" Link="chromium/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OpenOutlook.HeadlessTests" />
    <InternalsVisibleTo Include="OpenOutlook.Tests" />
  </ItemGroup>
</Project>
