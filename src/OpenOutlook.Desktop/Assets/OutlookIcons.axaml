  <!--
    Backstage nav variants ("R"). The stroke comes from the templated parent's Tag so each item can bind
    it to its own Foreground: grey normally, accent blue when selected, OlBsDisabled when disabled — one
    geometry per icon instead of a grey and a blue twin.
  -->
  <ControlTemplate x:Key="OlIconHomeR">
    <Canvas Width="32" Height="32">
      <Path Stroke="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.6" Fill="Transparent" Data="M5,15 L16,5 L27,15" />
      <Path Stroke="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.6" Fill="Transparent" Data="M8,13 L8,27 L24,27 L24,13" />
      <Path Stroke="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.4" Fill="Transparent" Data="M14,27 L14,19 L18,19 L18,27" />
    </Canvas>
  </ControlTemplate>

